{
	"name": "devcontainer",
	"image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"mads-hartmann.bash-ide-vscode",
				"dbaeumer.vscode-eslint",
				"EditorConfig.EditorConfig",
				"Anthropic.claude-code"
			]
		}
	},
	"mounts": [
		"source=${localEnv:HOME}/.devcontainer/.docker,target=/home/node/.docker,type=bind",
		"source=${localEnv:HOME}/.devcontainer/.agents,target=/home/node/.agents,type=bind",
		"source=${localEnv:HOME}/.devcontainer/.claude,target=/home/node/.claude,type=bind",
		"source=${localEnv:HOME}/.devcontainer/.claude.json,target=/home/node/.claude.json,type=bind"
	],
	"postCreateCommand": "npm install -g @devcontainers/cli"
}